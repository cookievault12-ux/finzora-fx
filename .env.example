# FINZORA FX — environment variables
# Copy to .env and fill in real values. NEVER commit .env. NEVER paste real values into chat.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
ANTHROPIC_API_KEY=
NEMOTRON_API_KEY=

# --- Market / macro / news data ---
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
# Twelve Data deferred per minimum-cost plan — add only if OANDA's own
# historical candles prove insufficient for intraday FX backfill.
TWELVEDATA_API_KEY=

# --- Broker: OANDA (primary, practice/demo first) ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice   # practice | live — must stay "practice" until live_trading_enabled=true AND manually authorized

# --- Broker: Saxo (secondary/alternate, demo) ---
SAXO_API_TOKEN=
SAXO_ACCOUNT_ID=
SAXO_ENVIRONMENT=simulation

# --- Database ---
DATABASE_URL=   # Neon Postgres connection string

# --- Deployment ---
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# --- Web login (HTTP Basic Auth, restricted to one hardcoded username —
# see src/auth/basic_auth.py). APP_PASSWORD_HASH is NEVER the plaintext
# password — it's the output of src/auth/basic_auth.py's hash_password(),
# e.g.: python3 -c "from src.auth.basic_auth import hash_password; print(hash_password('your-real-password'))"
APP_PASSWORD_HASH=
